# Copy this file to .env and fill in real values. Never commit the real .env file.

# Production startup enforces PostgreSQL, a strong JWT secret, and Cloudinary.
APP_ENV=development

# PostgreSQL connection string. For quick local dev you can instead leave this unset
# and the app will fall back to a local SQLite file (see app/core/config.py).
DATABASE_URL=postgresql://civicfix_user:changeme@localhost:5432/civicfix

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=8

# Optional in development; required in production for persistent image storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI model
AI_MODEL_PATH=../ai-model/models/civic_classifier.pt
AI_CONFIDENCE_THRESHOLD=0.55

# CORS
FRONTEND_ORIGIN=http://localhost:5173
